<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="kalman">
    <xacro:arg name="layouts" default="" />
    <xacro:property name="layouts_list" value="${'$(arg layouts)'.split()}" />

    <!-- base -->
    <xacro:include filename="$(find kalman_description)/urdf/kalman.urdf.xacro" />
    <xacro:kalman />

    <!-- arm -->
    <xacro:if value="${'arm' in layouts_list}">
        <xacro:include filename="$(find kalman_description)/urdf/arm.urdf.xacro" />
        <xacro:arm base_link="base_link" />
    </xacro:if>

    <!-- autonomy TODO -->
    <!-- <xacro:if value="${'autonomy' in layouts_list}">
        <xacro:include filename="$(find kalman_description)/urdf/autonomy.urdf.xacro" />
    </xacro:if> -->

    <!-- modules??? -->

</robot>