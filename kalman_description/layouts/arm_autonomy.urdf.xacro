<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="kalman">
    <!-- base Kalman links -->
    <xacro:include filename="$(find kalman_description)/urdf/kalman.urdf.xacro" />
    <xacro:kalman />

    <!-- arm links -->
    <xacro:include filename="$(find kalman_description)/urdf/arm.urdf.xacro" />
    <xacro:arm base_link="base_link" />

    <!-- IMU -->
    <link name="imu_link" />
    <joint name="imu_joint" type="fixed">
        <origin xyz="0.088 0.000 -0.015" rpy="0 0 -1.5708" />
        <parent link="base_link" />
        <child link="imu_link" />
    </joint>

    <!-- RealSense -->
    <xacro:include filename="$(find realsense2_description)/urdf/_d455.urdf.xacro" />
    <xacro:sensor_d455 name="d455_arm" parent="arm_link_6" use_nominal_extrinsics="true">
        <origin xyz="-0.1 0.0 0.035" rpy="0 -1.5708 0" />
    </xacro:sensor_d455>

    <!-- <xacro:include filename="$(find realsense2_description)/urdf/_d455.urdf.xacro" /> -->
    <xacro:sensor_d455
        name="d455_arm_wheel"
        parent="swivel_fl_link"
        use_nominal_extrinsics="true">
        <!-- <origin xyz="-0.012 0.019 0.059" rpy="0.000 0.550 -0.584" /> -->
        <!-- <origin xyz="0.100 -0.020 0.000" rpy="0.000 0.550 -0.584" /> -->
        <origin xyz="0.200 -0.03 0.000" rpy="0.000 0.550 -0.584" />
    </xacro:sensor_d455>

    <!-- <link name="aruco_under_j6" /> -->
    <!-- <joint name="aruco_joint" type="fixed"> -->
        <!-- <origin xyz="0.08 0 0.05" rpy="0.785 0 0" /> -->
        <!-- <origin xyz="0.117 0.011 0.062" rpy="3.086 0.784 -1.600" /> -->
        <!-- <parent link="arm_link_6" /> -->
        <!-- <child link="aruco_under_j6" /> -->
    <!-- </joint> -->

    <link name="aruco_under_j6" />
    <joint name="aruco_joint" type="fixed">
        <!-- <origin xyz="0.08 0 0.05" rpy="0.785 0 0" /> -->
        <!-- <origin xyz="0.0 0.0 -0.065" rpy="1.538 -0.116 -2.102" /> -->
        <origin xyz="0.006 0.0 -0.055" rpy="1.538 -0.116 -2.102" />
        <parent link="arm_link_end" />
        <child link="aruco_under_j6" />
    </joint>

    <link name="arm_link_gripper" />
    <joint name="arm_joint_for_gripper_end" type="fixed">
        <origin xyz="0.08 0.0 0.025" rpy="1.570 0.0 -1.570" />
        <parent link="arm_link_end" />
        <child link="arm_link_gripper" />
    </joint>

</robot>
