<root main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <Sequence name="PanelMissionSequence">
        <OpenGripper timeout_ms="5000" tolerance="0.20" />
        <ArmNavigateToPose j0="0.0" j1="-0.4098" j2="2.567" j3="0" j4="-0.6277" j5="0.0" />

        <ComputePanelTarget
            panel_relative_pose="{requested_panel_pose}"
            target_standoff="0.15"
            orientation_mode="normal_to_panel"
            target_pose="{coarse_pose}" />

        <SetMissionFeedback text="Moving to coarse panel target" />
        <IKNavigateToPose pose="{coarse_pose}" timeout_ms="30000" />

        <Say message="Coarse goal reached" />

        <!-- <OpenGripper timeout_ms="5000" tolerance="0.20" /> -->
        <SetGripperAngle degrees="30.0" timeout_ms="5000" tolerance_deg="10.0" />

        <TransformPose
          pose="{requested_panel_pose}"
          z="0.07"
          y="-0.02"
          transformed_pose="{requested_panel_pose_offset}" />

        <ForceSuccess>
            <VisualRefineToPanel
              pose="{requested_panel_pose_offset}"
              timeout_ms="10000" />
        </ForceSuccess>

        <VisaulRefineToPanelTwist
          pose="{requested_panel_pose_offset}"
          timeout_ms="40000" />

        <!-- Y here should be adjusted to if model is updated -->
        <TransformPose
          pose="{requested_panel_pose}"
          z="-0.02"
          y="0.00"
          transformed_pose="{requested_panel_pose_offset}" />

        <VisaulRefineToPanelTwist
          pose="{requested_panel_pose_offset}"
          timeout_ms="40000" />

        <CloseGripper timeout_ms="5000" tolerance="0.20" />

        <TransformPose
          pose="{requested_panel_pose_offset}"
          z="0.15"
          y="0.00"
          transformed_pose="{pose_with_bar}" />

        <VisaulRefineToPanelTwist
          pose="{pose_with_bar}"
          timeout_ms="40000" />

    </Sequence>
  </BehaviorTree>
</root>
