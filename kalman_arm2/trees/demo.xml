<root main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <Sequence name="PanelMissionSequence">
      <SetMissionFeedback text="Moving to observation pose" />
      <!-- <CloseGripper timeout_ms="5000" tolerance="0.20" /> -->
      <!-- <OpenGripper timeout_ms="5000" tolerance="0.20" /> -->
      <ArmNavigateToPose j0="0.0" j1="-1.2" j2="2.7" j3="0" j4="0.2" j5="0.0" />
      <!-- <ArmNavigateToPose j0="0.0" j1="0.0" j2="0.0" j3="0.0" j4="0.0" j5="0.0" jaw="0.0" /> -->

      <SetMissionFeedback text="Acquiring initial panel pose" />
      <Fallback name="EnsureInitialPanelPose">
        <Sequence>
          <IsPanelPoseAvailable />
          <IsPanelPoseFresh max_age_ms="500" />
        </Sequence>
        <AcquirePanelPose timeout_ms="3000" max_age_ms="300" />
        <Sequence>
           <!-- Keeping this block, as it may be useful to move the arm in a position where it won't occlude the panel -->
          <SetMissionFeedback text="Moving to recover panel view" />
          <FindPanel target_pose="{panel_find_pose}" />
          <IKNavigateToPose pose="{panel_find_pose}" timeout_ms="12000" />
          <AcquirePanelPose timeout_ms="3000" max_age_ms="300" />
        </Sequence>
      </Fallback>

      <IsPanelPoseGood
        max_age_ms="300"
        max_position_error="0.05"
        max_normal_error_deg="12.0" />

      <ComputePanelTarget
        panel_relative_pose="{requested_panel_pose}"
        target_standoff="0.2"
        orientation_mode="normal_to_panel"
        target_pose="{coarse_pose}" />

      <SetMissionFeedback text="Moving to coarse panel target" />
      <IKNavigateToPose pose="{coarse_pose}" timeout_ms="30000" />
      <Say message="Coarse goal reached" />

      <SetMissionFeedback text="Refreshing panel pose near target" />
      <Fallback name="RefreshPanelPoseNearTarget">
        <AcquirePanelPose timeout_ms="2000" max_age_ms="2000" />
        <Sequence>
          <SetMissionFeedback text="Moving to recover panel view" />
          <FindPanel target_pose="{panel_find_pose}" />
          <IKNavigateToPose pose="{panel_find_pose}" timeout_ms="12000" />
          <AcquirePanelPose timeout_ms="2000" max_age_ms="2000" />
        </Sequence>
      </Fallback>

      <Say message="Fine goal reached" />

      <IsPanelPoseGood
        max_age_ms="500"
        max_position_error="0.03"
        max_normal_error_deg="8.0" />

      <SetMissionFeedback text="Visually refining final panel target" />

      <!-- <OpenGripper timeout_ms="5000" tolerance="0.20" /> -->
      <SetGripperAngle degrees="30.0" timeout_ms="5000" tolerance_deg="10.0" />

      <TransformPose
        pose="{requested_panel_pose}"
        z="0.07"
        transformed_pose="{requested_panel_pose_offset}" />

      <ForceSuccess>
          <VisualRefineToPanel
            pose="{requested_panel_pose_offset}"
            timeout_ms="10000" />
      </ForceSuccess>

      <VisaulRefineToPanelTwist
        pose="{requested_panel_pose_offset}"
        timeout_ms="40000" />

      <CloseGripper timeout_ms="5000" tolerance="0.20" />
      <VisaulRefineToPanelTwist
        pose="{requested_panel_pose}"
        timeout_ms="30000" />

      <!-- Note, this does take the rotation into account! -->
      <TransformPose
        pose="{requested_panel_pose}"
        x="-0.05"
        transformed_pose="{requested_panel_pose_offset}" />

      <CloseGripper timeout_ms="5000" tolerance="0.20" />
      <OpenGripper timeout_ms="5000" tolerance="0.20" />

      <!-- <VisaulRefineToPanelTwist
        pose="{requested_panel_pose_offset}"
        timeout_ms="40000" /> -->

      <!-- <CloseGripper timeout_ms="5000" tolerance="0.20" /> -->

      <!-- <TransformPose
        pose="{requested_panel_pose}"
        z="0.25"
        transformed_pose="{requested_panel_pose_offset}" /> -->

      <!-- <VisaulRefineToPanelTwist
        pose="{requested_panel_pose_offset}"
        timeout_ms="40000" /> -->

      <!-- <RotateEEAlongNormalJoint degrees="45.0"/> -->

      <!-- <CloseGripper timeout_ms="5000" tolerance="0.20" /> -->

      <!-- <RotateEEAlongNormalJoint degrees="45.0" /> -->
      <!-- <RotateEEAlongNormalJoint degrees="45.0" /> -->
      <!-- <OpenGripper timeout_ms="5000" tolerance="0.20" /> -->
    </Sequence>
  </BehaviorTree>
</root>
