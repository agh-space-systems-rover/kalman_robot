<root main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <Sequence name="PanelMissionSequence">
      <SetMissionFeedback text="Moving to observation pose" />
      <ArmNavigateToPose j0="0.0" j1="-1.2" j2="2.9" j3="0" j4="0.2" j5="0.0" jaw="0.0" />

      <SetMissionFeedback text="Acquiring initial panel pose" />
      <Fallback name="EnsureInitialPanelPose">
        <Sequence>
          <IsPanelPoseAvailable />
          <IsPanelPoseFresh max_age_ms="300" />
        </Sequence>
        <AcquirePanelPose timeout_ms="3000" max_age_ms="300" />
        <Sequence>
          <SetMissionFeedback text="Moving to recover panel view" />
          <FindPanel target_pose="{panel_find_pose}" />
          <IKNavigateToPose pose="{panel_find_pose}" timeout_ms="12000" />
          <AcquirePanelPose timeout_ms="3000" max_age_ms="300" />
        </Sequence>
      </Fallback>

      <IsPanelPoseGood
        max_age_ms="300"
        max_position_error="0.05"
        max_normal_error_deg="12.0" />

      <ComputePanelTarget
        panel_relative_pose="{requested_panel_pose}"
        target_standoff="0.4"
        orientation_mode="normal_to_panel"
        target_pose="{coarse_pose}" />

      <SetMissionFeedback text="Moving to coarse panel target" />
      <IKNavigateToPose pose="{coarse_pose}" timeout_ms="12000" />
      <Say message="Coarse goal reached" />

      <SetMissionFeedback text="Refreshing panel pose near target" />
      <Fallback name="RefreshPanelPoseNearTarget">
        <AcquirePanelPose timeout_ms="2000" max_age_ms="2000" />
        <Sequence>
          <SetMissionFeedback text="Moving to recover panel view" />
          <FindPanel target_pose="{panel_find_pose}" />
          <IKNavigateToPose pose="{panel_find_pose}" timeout_ms="12000" />
          <AcquirePanelPose timeout_ms="2000" max_age_ms="2000" />
        </Sequence>
      </Fallback>

      <Say message="Fine goal reached" />

      <IsPanelPoseGood
        max_age_ms="200"
        max_position_error="0.03"
        max_normal_error_deg="8.0" />

      <ComputePanelTarget
        panel_relative_pose="{requested_panel_pose}"
        orientation_mode="normal_to_panel"
        target_pose="{target_pose}" />

      <SetMissionFeedback text="Moving to final panel target" />
      <IKNavigateToPose pose="{target_pose}" timeout_ms="15000" />
    </Sequence>
  </BehaviorTree>
</root>
