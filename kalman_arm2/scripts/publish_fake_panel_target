#!/usr/bin/env python3
"""Publish sample geometry_msgs/PoseStamped on /arm/panel/target (same format as GS SEND)."""

import argparse

import rclpy
from geometry_msgs.msg import PoseStamped
from rclpy.node import Node


class FakePanelTargetPublisher(Node):
    def __init__(self, topic: str, x: float, y: float, frame_id: str, rate_hz: float):
        super().__init__("fake_panel_target_publisher")
        self._publisher = self.create_publisher(PoseStamped, topic, 10)
        self._x = x
        self._y = y
        self._frame_id = frame_id
        self._rate_hz = rate_hz
        if rate_hz > 0:
            self._timer = self.create_timer(1.0 / rate_hz, self._publish)
        self._publish()

    def _publish(self):
        msg = PoseStamped()
        msg.header.stamp = self.get_clock().now().to_msg()
        msg.header.frame_id = self._frame_id
        msg.pose.position.x = self._x
        msg.pose.position.y = self._y
        msg.pose.position.z = 0.0
        msg.pose.orientation.x = 0.0
        msg.pose.orientation.y = 0.0
        msg.pose.orientation.z = 0.0
        msg.pose.orientation.w = 1.0
        self._publisher.publish(msg)
        self.get_logger().info(
            f"Published PoseStamped on /arm/panel/target: "
            f"frame_id={self._frame_id}, x={self._x}, y={self._y}"
        )


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument(
        "--topic",
        default="/arm/panel/target",
        help="PoseStamped topic (default: /arm/panel/target)",
    )
    parser.add_argument("--x", type=float, default=225.0, help="panel x (default: 225)")
    parser.add_argument("--y", type=float, default=320.0, help="panel y (default: 320)")
    parser.add_argument(
        "--frame-id",
        default="button_a (95%)",
        help="header.frame_id / detection label (default: button_a (95%%))",
    )
    parser.add_argument(
        "--rate",
        type=float,
        default=0.0,
        help="Publish rate in Hz; 0 = once (default: 0)",
    )
    args = parser.parse_args()

    rclpy.init()
    node = FakePanelTargetPublisher(args.topic, args.x, args.y, args.frame_id, args.rate)
    try:
        if args.rate > 0:
            rclpy.spin(node)
    except KeyboardInterrupt:
        pass
    finally:
        node.destroy_node()
        rclpy.shutdown()


if __name__ == "__main__":
    main()
